<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>Agent token — {{name}}</title>
    <style>
      body {
        font-family: -apple-system, system-ui, sans-serif;
        margin: 2rem;
        color: #222;
      }
      .warn {
        background: #fff6cc;
        border: 1px solid #caa;
        padding: 0.75rem;
      }
      code {
        background: #111;
        color: #fff;
        padding: 0.5rem;
        font-size: 14px;
        display: block;
        margin: 1rem 0;
        word-break: break-all;
      }
      a {
        color: #06c;
      }
    </style>
  </head>
  <body>
    <h1>Agent created</h1>
    <p><strong>Name:</strong>
      {{name}}<br />
      <strong>ID:</strong>
      <code>{{id}}</code></p>

    <div class='warn'>⚠ Copy this token now. It is shown only once.</div>
    <code>{{token}}</code>

    <p>Run the agent with:</p>
    <code>preview-agent start --hub-url ws://localhost:3000/agent/ws --token {{token}}</code>

    <p><a href='/admin'>← Back to agents list</a></p>
  </body>
</html>