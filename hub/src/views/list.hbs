<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta http-equiv='refresh' content='10' />
    <title>Preview — Agents</title>
    <style>
      body {
        font-family: -apple-system, system-ui, sans-serif;
        margin: 2rem;
        color: #222;
      }
      h1 {
        margin-top: 0;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin-top: 1rem;
      }
      th,
      td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid #ddd;
        text-align: left;
        font-size: 14px;
      }
      th {
        background: #f5f5f5;
      }
      .status-online {
        color: #0a0;
        font-weight: bold;
      }
      .status-offline {
        color: #888;
      }
      form {
        margin-top: 1rem;
        padding: 1rem;
        background: #fafafa;
        border: 1px solid #eee;
      }
      input,
      textarea,
      button {
        font-size: 14px;
        padding: 0.35rem;
      }
      textarea {
        width: 100%;
        min-height: 60px;
        font-family: monospace;
      }
      .banner {
        background: #ffdede;
        border: 1px solid #c00;
        color: #800;
        padding: 0.5rem 0.75rem;
        margin-bottom: 1rem;
      }
      form.inline {
        display: inline;
        margin: 0;
        padding: 0;
        border: none;
        background: none;
      }
      button.danger {
        background: #d33;
        color: white;
        border: none;
        padding: 0.2rem 0.5rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    {{#if unsafeBanner}}
      <div class='banner'>⚠ Admin API exposed beyond localhost (ADMIN_UNSAFE_ALLOW_NONLOCAL=1).
        Phase 3 auth 미구현.</div>
    {{/if}}
    <h1>Agents</h1>
    <form method='post' action='/admin/ui/agents'>
      <div>
        <label>Name <input type='text' name='name' maxlength='64' required /></label>
      </div>
      <div>
        <label>Labels (JSON object, optional)<br />
          <textarea name='labels' placeholder='{"zone": "home"}'></textarea>
        </label>
      </div>
      <button type='submit'>Create Agent</button>
    </form>

    <table>
      <thead>
        <tr><th>Name</th><th>ID</th><th>Labels</th><th>Status</th><th>Last seen</th><th
          >Created</th><th></th></tr>
      </thead>
      <tbody>
        {{#each agents}}
          <tr>
            <td>{{this.name}}</td>
            <td><code>{{this.id}}</code></td>
            <td><code>{{this.labelsJson}}</code></td>
            <td class='status-{{this.status}}'>{{this.status}}</td>
            <td>{{this.lastSeenAt}}</td>
            <td>{{this.createdAt}}</td>
            <td>
              <form class='inline' method='post' action='/admin/ui/agents/{{this.id}}/delete'>
                <button type='submit' class='danger'>Delete</button>
              </form>
            </td>
          </tr>
        {{/each}}
        {{#unless agents.length}}
          <tr><td colspan='7'><em>No agents. Create one above.</em></td></tr>
        {{/unless}}
      </tbody>
    </table>
  </body>
</html>