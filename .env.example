# Preview — 환경 변수 템플릿
# 복사 후 값을 채워 넣으세요:  cp .env.example .env
# ⚠  .env는 시크릿을 포함하므로 git에 커밋하지 마세요 (.gitignore 등록됨).

# ── Hub ───────────────────────────────────────────────────────────────────────

# DB 연결. sqlite://<경로> 또는 postgres://user:pass@host:port/db
DATABASE_URL=sqlite://./hub.db

# Hub HTTP 서버 bind 주소.
HUB_ADDR=:3000

# slog 레벨: debug / info / warn / error
LOG_LEVEL=info

# bcrypt cost (기본 10).
BCRYPT_COST=10

# /admin/* 라우트 Basic Auth 비밀번호. 빈 값 = 인증 없음 (개발 전용).
ADMIN_PASSWORD=

# GitHub 웹훅 서명 검증 HMAC 시크릿. GitHub 웹훅 설정에서 복사.
GITHUB_WEBHOOK_SECRET=

# 리버스 프록시 호스트 매칭 기본 도메인.
# 로컬 개발: localhost  /  운영: example.com
PREVIEW_BASE_DOMAIN=localhost

# Agent 바이너리 다운로드 base URL (빈 값이면 소스 빌드 안내 표시).
AGENT_DOWNLOAD_URL=

# Reconciler 튜닝 (기본값으로 운영 가능).
RECONCILE_INTERVAL=1m
STALE_ASSIGNED_AFTER=5m

# ── Agent ─────────────────────────────────────────────────────────────────────

# Agent가 Hub에 접속할 WebSocket URL.
HUB_URL=ws://localhost:3000/agent/ws

# Agent 인증 토큰 (Hub Admin > Agents에서 발급).
HUB_TOKEN=

# Private 저장소 HTTPS clone/fetch용 GitHub PAT (scope: repo 또는 public_repo).
GITHUB_TOKEN=

# Agent가 Traefik에 광고할 호스트 주소 (Docker Compose 기본값: host.docker.internal).
AGENT_ADVERTISE_HOST=

# 기타 Agent 설정 (기본값 그대로 사용 가능).
AGENT_PREFETCH_INTERVAL=5m
AGENT_MAX_JOBS=1
