# Preview environment variables -- copy to .env and fill in.

# DB driver + DSN. sqlite://<path> or postgres://user:pass@host:port/db
DATABASE_URL=sqlite://./hub.db

# Bind address for the Hub HTTP server.
HUB_ADDR=:3000

# bcrypt cost for token hashing (default 10).
BCRYPT_COST=10

# slog level: debug / info / warn / error.
LOG_LEVEL=info

# HTTP Basic Auth password for /admin/* routes (Phase 3).
# Empty value = no authentication (development only) + WARN log on startup.
# Strongly recommended in production. Username is hardcoded as "admin".
ADMIN_PASSWORD=

# HMAC secret for GitHub webhook verification (Phase 2, required).
GITHUB_WEBHOOK_SECRET=

# Base domain for reverse-proxy host matching.
# The proxy intercepts requests to pr-N.preview.<PREVIEW_BASE_DOMAIN>.
# For local dev set to "localhost"; for production set to your domain, e.g. "example.com".
PREVIEW_BASE_DOMAIN=localhost

# Repo URL the Hub resolves to when forwarding JOB_ASSIGN to the Agent.
# In single-repo mode set this to the git remote URL.
PREVIEW_REPO_URL=

# Reconciler tuning (optional, defaults work for production).
RECONCILE_INTERVAL=1m
STALE_ASSIGNED_AFTER=5m

# Agent configuration (used by cmd/agent).
HUB_URL=ws://localhost:3000/agent/ws
HUB_TOKEN=
AGENT_LABELS=
AGENT_ADVERTISE_HOST=
AGENT_REPO_URL=
AGENT_WORK_DIR=~/.hub-agent
AGENT_PREFETCH_INTERVAL=5m
AGENT_MAX_JOBS=1

# ── docker compose 전용 ────────────────────────────────────────────────────
# docker compose up 으로 Hub + Agent 를 함께 실행할 때 필요한 변수.

# Hub 가 외부에 노출할 포트 (기본: 3000)
HUB_PORT=3000

# Agent 가 등록 후 발급받은 토큰 (hub/admin 에서 발급, compose 재시작 시 재사용)
AGENT_TOKEN=

# Agent 컨테이너에서 PR 컨테이너를 빌드할 git URL
# (AGENT_REPO_URL 과 동일 값)

# Agent 가 Hub 에 보고하는 호스트 주소.
# docker compose 환경에서는 host.docker.internal (macOS/Windows) 또는
# 172.17.0.1 (Linux Docker bridge) 을 사용.
AGENT_ADVERTISE_HOST=host.docker.internal
