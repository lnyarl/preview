# Preview environment variables — copy to .env and fill in.
# Phase 0 does not read any of these; listed only for forward reference.

# DB driver + DSN. sqlite://<path> or postgres://user:pass@host:port/db
DATABASE_URL=sqlite://./hub.db

# Bind address for the Hub HTTP server (used from Phase 1+).
HUB_ADDR=:8080

# HMAC secret for GitHub webhook verification (Phase 1).
GITHUB_WEBHOOK_SECRET=

# Token an Agent uses to authenticate its outbound WebSocket (Phase 2).
AGENT_TOKEN=

# Base domain for reverse-proxy host matching, e.g. preview.example.com (Phase 3+).
PREVIEW_BASE_DOMAIN=preview.example.com
