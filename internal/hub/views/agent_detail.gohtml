{{define "content"}}
<hgroup>
  <h1>Agent: {{.Name}}</h1>
  <h2>Status: {{.Status}}{{if .LastSeenString}} · Last seen: {{.LastSeenString}}{{end}}</h2>
</hgroup>

<p><a href="/admin/agents">&larr; Back to agents</a></p>

{{if .Error}}
  <article role="alert">{{.Error}}</article>
{{end}}

{{if .SavedFlash}}
  <article role="alert">Saved. CONFIG_UPDATE was {{.PushOutcome}}.</article>
{{end}}

<section>
  <h3>Metadata</h3>
  <dl>
    <dt>ID</dt><dd><code>{{.AgentID}}</code></dd>
    <dt>Labels</dt><dd>{{if .LabelsString}}{{.LabelsString}}{{else}}<em>none</em>{{end}}</dd>
    <dt>Created</dt><dd>{{.CreatedString}}</dd>
  </dl>
</section>

<section>
  <h3>Run Commands</h3>
  <form method="POST" action="/admin/agents/{{.AgentID}}/config">
    <label for="run_commands">Run commands (one per line)</label>
    <textarea id="run_commands" name="run_commands" rows="6">{{.RunCommandsText}}</textarea>
    <small>Each line runs as <code>sh -c &lt;line&gt;</code> in the directory where the repository was checked out. Non-zero exit aborts the run.</small>

    <label for="container_port">Container port</label>
    <input type="number" id="container_port" name="container_port"
           min="1" max="65535"
           value="{{if gt .ContainerPort 0}}{{.ContainerPort}}{{else}}80{{end}}">
    <small>Port the application listens on inside the container. 0 / out-of-range = default 80.</small>

    <button type="submit">Save</button>
  </form>
  <small>Changes apply to the <strong>next</strong> run. In-flight runs keep their snapshot.</small>
</section>

<section>
  <h3>Available environment variables</h3>
  <table>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Value</th>
      </tr>
    </thead>
    <tbody>
      <tr><td><code>$PREVIEW_ID</code></td><td>UUID of the preview</td></tr>
      <tr><td><code>$PREVIEW_SHA</code></td><td>Git commit hash</td></tr>
      <tr><td><code>$PREVIEW_BRANCH</code></td><td>Git branch name (may be empty)</td></tr>
      <tr><td><code>$PORT</code></td><td>Resolved container port (default 80)</td></tr>
    </tbody>
  </table>
</section>
{{end}}
