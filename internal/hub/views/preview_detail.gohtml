{{define "content"}}
<hgroup>
  <h1>{{.Title}}</h1>
  <h2>Preview detail and timeline</h2>
</hgroup>

{{if .ConflictMessage}}
  <article role="alert">{{.ConflictMessage}}</article>
{{end}}

{{if and (eq .Preview.Status "failed") .Diagnosis}}
  <article role="alert">
    <strong>실패 원인:</strong> {{.Diagnosis}}
    {{if .BuildOutput}}
    <pre style="margin:0.6em 0 0; white-space:pre-wrap; word-break:break-all; font-size:0.8em; background:var(--pico-code-background-color); padding:0.6em; border-radius:4px;">{{.BuildOutput}}</pre>
    {{end}}
    {{if .Preview.ErrorMessage}}
    <details style="margin-top:0.5em;">
      <summary style="cursor:pointer; font-size:0.85em; color:var(--pico-muted-color);">전체 오류 보기</summary>
      <pre style="margin:0.4em 0 0; white-space:pre-wrap; word-break:break-all; font-size:0.75em;">{{.Preview.ErrorMessage}}</pre>
    </details>
    {{end}}
  </article>
{{end}}

<section>
  <dl>
    <dt>Status</dt>
    <dd>{{statusBadge .Preview.Status}}</dd>
    <dt>Repo</dt><dd>{{.Preview.RepoFullName}}</dd>
    <dt>Branch</dt><dd><code>{{.Preview.Branch}}</code></dd>
    <dt>Commit</dt><dd><code>{{if .Preview.CommitSha}}{{.Preview.CommitSha}}{{else}}<em>not set</em>{{end}}</code></dd>
    <dt>Source</dt><dd>{{if .Preview.IsAdhoc}}Adhoc (manual){{else}}Webhook{{end}}</dd>
    <dt>Agent</dt><dd>{{.AgentLine}}</dd>
    <dt>URLs</dt>
    <dd>
      {{if .PreviewURLs}}
        {{range $name, $url := .PreviewURLs}}<a href="{{$url}}" target="_blank">{{$name}}</a> {{end}}
      {{else}}
        <em>not running</em>
      {{end}}
    </dd>
  </dl>
</section>

<section style="display:flex; gap:1rem; align-items:flex-start; flex-wrap:wrap;">
  <div>
    <form method="POST" action="/admin/previews/{{.Preview.ID}}/rebuild">
      <button type="submit"{{if not .RebuildEnabled}} disabled{{end}}>Re-run</button>
    </form>
    <small>Status가 <code>done</code> 또는 <code>failed</code>일 때 활성화됩니다.</small>
  </div>
  <div>
    <form method="POST" action="/admin/previews/{{.Preview.ID}}/stop">
      <button type="submit" class="contrast"{{if not .StopEnabled}} disabled{{end}}>Stop</button>
    </form>
    <small>Status가 <code>running</code>일 때 활성화됩니다.</small>
  </div>
</section>

<section>
  <h3>Timeline</h3>
  {{if and (eq (len .Events) 0) (eq (len .OlderEvents) 0)}}
    <p><em>No events recorded yet.</em></p>
  {{else}}
    <table>
      <thead>
        <tr>
          <th scope="col" style="white-space:nowrap; width:14em;">Time</th>
          <th scope="col" style="white-space:nowrap; width:14em;">Transition</th>
          <th scope="col">Message</th>
        </tr>
      </thead>
      <tbody>
      {{range .Events}}
        <tr>
          <td style="white-space:nowrap; font-size:0.85em;">{{.TimeString}}</td>
          <td style="white-space:nowrap;"><code>{{.FromString}}</code> &rarr; <code>{{.ToStatus}}</code></td>
          <td style="font-size:0.85em; word-break:break-all;">{{.Message}}</td>
        </tr>
      {{end}}
      </tbody>
    </table>

    {{if .OlderEvents}}
    <details style="margin-top:0.5em;">
      <summary style="cursor:pointer; font-size:0.9em; color:var(--pico-muted-color);">
        이전 로그 {{len .OlderEvents}}개 더 보기
      </summary>
      <table style="margin-top:0.5em;">
        <tbody>
        {{range .OlderEvents}}
          <tr>
            <td style="white-space:nowrap; font-size:0.85em; width:14em;">{{.TimeString}}</td>
            <td style="white-space:nowrap; width:14em;"><code>{{.FromString}}</code> &rarr; <code>{{.ToStatus}}</code></td>
            <td style="font-size:0.85em; word-break:break-all;">{{.Message}}</td>
          </tr>
        {{end}}
        </tbody>
      </table>
    </details>
    {{end}}
  {{end}}
</section>
{{end}}
