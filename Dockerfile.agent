FROM golang:1.22-alpine AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /agent ./cmd/agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates git docker-cli docker-cli-compose
COPY --from=builder /agent /usr/local/bin/agent
ENTRYPOINT ["agent"]
