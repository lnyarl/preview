{
  "name": "preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted Vercel Preview for GitHub PRs",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter @preview/shared --filter @preview/hub --filter @preview/agent build",
    "typecheck": "pnpm -r --filter @preview/shared --filter @preview/hub --filter @preview/agent typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:hub": "pnpm --filter @preview/hub dev",
    "dev:agent": "pnpm --filter @preview/agent dev",
    "test": "pnpm -r --filter @preview/shared --filter @preview/hub --filter @preview/agent test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0"
  }
}
